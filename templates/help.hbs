{{!-- Reference/help overlay (SPEC §13 Item 1): a fa-circle-question button in
      the header row that opens an in-app overlay (NOT a Foundry Dialog) listing
      every Black ICE, program and demon. Entries relevant to the viewing player
      carry an accent highlight frame. --}}
{{#if help}}
<button type="button" class="crns-icon-btn crns-help-btn" data-action="help-open"
        title="{{localize "CRNS.Help.Open"}}" aria-label="{{localize "CRNS.Help.Open"}}">
  <i class="fas fa-circle-question"></i>
</button>

<div class="crns-help-overlay" tabindex="-1" role="dialog" aria-label="{{localize "CRNS.Help.Title"}}">
  <div class="crns-help-panel">
    <div class="crns-help-head">
      <span class="crns-help-title"><i class="fas fa-circle-question"></i> {{localize "CRNS.Help.Title"}}</span>
      <button type="button" class="crns-icon-btn crns-help-close" data-action="help-close"
              title="{{localize "CRNS.Help.Close"}}" aria-label="{{localize "CRNS.Help.Close"}}">
        <i class="fas fa-xmark"></i>
      </button>
    </div>

    <div class="crns-help-body">
      {{!-- ===== Black ICE ===== --}}
      <h3 class="crns-help-sec"><i class="fas fa-skull"></i> {{localize "CRNS.Help.BlackIce"}}</h3>

      <h4 class="crns-help-subsec">{{localize "CRNS.Help.AntiNetrunner"}}</h4>
      <div class="crns-help-grid">
        {{#each help.iceAntiNetrunner as |e|}}
        <div class="crns-help-entry crns-help-ice{{#if e.framed}} framed{{/if}}"{{#if e.framed}} title="{{localize "CRNS.Help.FrameIce"}}"{{/if}}>
          <img class="crns-help-portrait" src="{{e.img}}" alt="{{e.name}}" />
          <div class="crns-help-info">
            <div class="crns-help-name">{{e.name}}</div>
            <div class="crns-help-stats">
              <span>{{localize "CRNS.Help.StatPer"}} {{e.per}}</span>
              <span>{{localize "CRNS.Help.StatSpd"}} {{e.spd}}</span>
              <span>{{localize "CRNS.Help.StatAtk"}} {{e.atk}}</span>
              <span>{{localize "CRNS.Help.StatDef"}} {{e.def}}</span>
              <span>{{localize "CRNS.Help.StatRez"}} {{e.rez}}</span>
            </div>
            <div class="crns-help-effect">{{e.effect}}</div>
          </div>
        </div>
        {{/each}}
      </div>

      <h4 class="crns-help-subsec">{{localize "CRNS.Help.AntiProgram"}}</h4>
      <div class="crns-help-grid">
        {{#each help.iceAntiProgram as |e|}}
        <div class="crns-help-entry crns-help-ice{{#if e.framed}} framed{{/if}}"{{#if e.framed}} title="{{localize "CRNS.Help.FrameIce"}}"{{/if}}>
          <img class="crns-help-portrait" src="{{e.img}}" alt="{{e.name}}" />
          <div class="crns-help-info">
            <div class="crns-help-name">{{e.name}}</div>
            <div class="crns-help-stats">
              <span>{{localize "CRNS.Help.StatPer"}} {{e.per}}</span>
              <span>{{localize "CRNS.Help.StatSpd"}} {{e.spd}}</span>
              <span>{{localize "CRNS.Help.StatAtk"}} {{e.atk}}</span>
              <span>{{localize "CRNS.Help.StatDef"}} {{e.def}}</span>
              <span>{{localize "CRNS.Help.StatRez"}} {{e.rez}}</span>
            </div>
            <div class="crns-help-effect">{{e.effect}}</div>
          </div>
        </div>
        {{/each}}
      </div>

      {{!-- ===== Programs ===== --}}
      <h3 class="crns-help-sec"><i class="fas fa-microchip"></i> {{localize "CRNS.Help.Programs"}}</h3>

      <h4 class="crns-help-subsec">{{localize "CRNS.Help.Boosters"}}</h4>
      <div class="crns-help-grid">
        {{#each help.boosters as |e|}}
        <div class="crns-help-entry crns-help-prog{{#if e.framed}} framed{{/if}}"{{#if e.framed}} title="{{localize "CRNS.Help.FrameProgram"}}"{{/if}}>
          <span class="crns-help-code">{{e.code}}</span>
          <div class="crns-help-info">
            <div class="crns-help-name">{{e.name}}</div>
            <div class="crns-help-stats">
              <span>{{localize "CRNS.Help.StatAtk"}} {{e.atk}}</span>
              <span>{{localize "CRNS.Help.StatDef"}} {{e.def}}</span>
              <span>{{localize "CRNS.Help.StatRez"}} {{e.rez}}</span>
            </div>
            <div class="crns-help-effect">{{e.effect}}</div>
          </div>
        </div>
        {{/each}}
      </div>

      <h4 class="crns-help-subsec">{{localize "CRNS.Help.Defenders"}}</h4>
      <div class="crns-help-grid">
        {{#each help.defenders as |e|}}
        <div class="crns-help-entry crns-help-prog{{#if e.framed}} framed{{/if}}"{{#if e.framed}} title="{{localize "CRNS.Help.FrameProgram"}}"{{/if}}>
          <span class="crns-help-code">{{e.code}}</span>
          <div class="crns-help-info">
            <div class="crns-help-name">{{e.name}}</div>
            <div class="crns-help-stats">
              <span>{{localize "CRNS.Help.StatAtk"}} {{e.atk}}</span>
              <span>{{localize "CRNS.Help.StatDef"}} {{e.def}}</span>
              <span>{{localize "CRNS.Help.StatRez"}} {{e.rez}}</span>
            </div>
            <div class="crns-help-effect">{{e.effect}}</div>
          </div>
        </div>
        {{/each}}
      </div>

      <h4 class="crns-help-subsec">{{localize "CRNS.Help.Attackers"}}</h4>
      <div class="crns-help-grid">
        {{#each help.attackers as |e|}}
        <div class="crns-help-entry crns-help-prog{{#if e.framed}} framed{{/if}}"{{#if e.framed}} title="{{localize "CRNS.Help.FrameProgram"}}"{{/if}}>
          <span class="crns-help-code">{{e.code}}</span>
          <div class="crns-help-info">
            <div class="crns-help-name">{{e.name}}</div>
            <div class="crns-help-stats">
              <span>{{localize "CRNS.Help.StatAtk"}} {{e.atk}}</span>
              <span>{{localize "CRNS.Help.StatDef"}} {{e.def}}</span>
              <span>{{localize "CRNS.Help.StatRez"}} {{e.rez}}</span>
            </div>
            <div class="crns-help-effect">{{e.effect}}</div>
          </div>
        </div>
        {{/each}}
      </div>

      {{!-- ===== Demons ===== --}}
      <h3 class="crns-help-sec"><i class="fas fa-hat-wizard"></i> {{localize "CRNS.Help.Demons"}}</h3>
      <div class="crns-help-grid">
        {{#each help.demons as |e|}}
        <div class="crns-help-entry crns-help-demon">
          <img class="crns-help-portrait" src="{{e.img}}" alt="{{e.name}}" />
          <div class="crns-help-info">
            <div class="crns-help-name">{{e.name}}</div>
            <div class="crns-help-stats">
              <span>{{localize "CRNS.Help.StatRez"}} {{e.rez}}</span>
              <span>{{localize "CRNS.Help.StatInt"}} {{e.interface}}</span>
              <span>{{localize "CRNS.Help.StatNa"}} {{e.actions}}</span>
              <span>{{localize "CRNS.Help.StatCn"}} {{e.cn}}</span>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>
{{/if}}
