{{!-- Open-architecture tab strip. --}}
<div class="crns-tabstrip">
  {{#if tabsGM}}
    {{#each tabsGM.tabs as |tab|}}
    <div class="crns-tab{{#if tab.active}} active{{/if}}{{#if tab.editing}} editing{{/if}}" data-arch-id="{{tab.archId}}" data-action="tab-activate">
      {{#if tab.editing}}<i class="fas fa-pen crns-tab-badge" title="{{localize "CRNS.Tabs.Editing"}}"></i>{{/if}}
      <span class="crns-tab-name">{{tab.name}}</span>
      <button type="button" class="crns-icon-btn crns-tab-edit" data-action="tab-edit" title="{{localize "CRNS.Tabs.EditToggle"}}"><i class="fas fa-pen-to-square"></i></button>
      <button type="button" class="crns-icon-btn crns-tab-close" data-action="tab-close" title="{{localize "CRNS.Tabs.Close"}}"><i class="fas fa-times"></i></button>
    </div>
    {{/each}}
  {{else}}
    {{#if tabsWatch}}
    <button type="button" class="crns-btn crns-watch-toggle" data-action="watch-toggle" aria-expanded="{{tabsWatch.open}}" aria-controls="crns-watch-menu">
      <i class="fas fa-eye"></i> {{localize "CRNS.Tabs.Watch"}}
    </button>
    {{#if tabsWatch.canLeave}}
    <button type="button" class="crns-btn crns-watch-leave" data-action="spectate-leave" data-pid="{{tabsWatch.spectatorPid}}">
      <i class="fas fa-arrow-left"></i> {{#if tabsWatch.hasOwnRunner}}{{localize "CRNS.Tabs.ReturnToRunner"}}{{else}}{{localize "CRNS.Tabs.StopWatching"}}{{/if}}
    </button>
    {{/if}}
    {{/if}}
  {{/if}}
</div>
{{#if equipmentAvailable}}
<button type="button" class="crns-icon-btn" data-action="equipment-open" title="{{localize "CRNS.Equipment.Title"}}"><i class="fas fa-microchip"></i></button>
{{/if}}
{{#if tabsWatch.open}}
<div class="crns-watch-menu" id="crns-watch-menu" role="region" aria-label="{{localize "CRNS.Tabs.Watch"}}">
  {{#if tabsWatch.permissionDenied}}
  <p class="crns-watch-hint">{{localize "CRNS.Errors.SpectatorsDisabled"}}</p>
  {{else}}
  {{#if tabsWatch.switchLocked}}<p class="crns-watch-hint">{{localize "CRNS.Errors.SpectatorSwitchLocked"}}</p>{{/if}}
  {{/if}}
  {{#each tabsWatch.targets as |target|}}
  <button type="button" class="crns-btn crns-watch-target{{#if target.active}} active{{/if}}" data-action="spectate-switch" data-arch-id="{{target.archId}}" data-follow-pid="{{target.pid}}"{{#if target.disabled}} disabled{{/if}}>
    <span class="crns-watch-name">{{target.name}}</span> <span class="crns-watch-arch">{{target.archName}}</span>
  </button>
  {{else}}
  <p class="crns-watch-hint">{{localize "CRNS.Tabs.NoWatchTargets"}}</p>
  {{/each}}
</div>
{{/if}}
